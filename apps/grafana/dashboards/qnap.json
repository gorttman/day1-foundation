    {
      "id": 12,
      "type": "timeseries",
      "title": "Busy processes: rsync, snapshot jobs, stuck on disk",
      "description": "rsync = running copy processes. snapshot_jobs = qnap-snapshot.sh instances. blocked = processes waiting on disk (D state).",
      "datasource": {
        "type": "influxdb",
