    {
      "id": 8,
      "type": "timeseries",
      "title": "Backup drive: used and free (TB)",
      "description": "Watch this go down after the folder is deleted. Used in one line, free in the other.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-pilab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-pilab"
          },
          "query": "from(bucket: \"telegraf\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"qnap_fs\" and r.mount == \"backup\" and (r._field == \"used_b\" or r._field == \"free_b\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> map(fn: (r) => ({_time: r._time, _value: float(v: r._value) / 1e12, _field: if r._field == \"used_b\" then \"used\" else \"free\"}))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: TB",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "drawStyle": "line",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 3
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "last",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
