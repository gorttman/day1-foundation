                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 150000000
              },
              {
                "color": "green",
                "value": 300000000
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 0
