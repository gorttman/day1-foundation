    {
      "id": 10,
      "type": "timeseries",
      "title": "Load average",
      "description": "1, 5 and 15 minute load. Sustained values above 4 mean the QNAP is busier than its 4 cores.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-pilab"
      },
      "targets": [
        {
          "refId": "A",
