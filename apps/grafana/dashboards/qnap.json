    {
      "id": 7,
      "type": "stat",
      "title": "Memory available",
      "description": "RAM the QNAP can still use (free plus caches). Very low values mean swapping or OOM risk.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-pilab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-pilab"
          },
          "query": "from(bucket: \"telegraf\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"qnap_mem\" and r._field == \"avail_kb\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: float(v: r._value) * 1024.0}))\n  |> keep(columns: [\"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
