    {
      "id": 4,
      "type": "stat",
      "title": "QNAP reachable",
      "description": "Reads 1 when the watcher could SSH in on its last attempt. 0 means the QNAP is not answering.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-pilab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-pilab"
          },
          "query": "from(bucket: \"telegraf\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"qnap_watch\" and r._field == \"up\")\n  |> last()\n  |> keep(columns: [\"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 12,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Data RAID degraded",
      "description": "0 = all 6 disks present. 1 = a disk is missing or failed.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-pilab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
