    {
      "type": "stat",
      "title": "Longhorn volumes healthy",
      "description": "Attached Longhorn volumes that are healthy, out of all attached volumes. Detached volumes report robustness 'unknown' by design and are not counted. Full green only when every one is good; light green at 90% or more, yellow at 70%, orange at 40%, red below that.",
      "id": 22,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-pilab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-pilab"
          },
          "query": "from(bucket: \"telegraf\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"prometheus\" and r.service == \"longhorn\" and r._field == \"longhorn_volume_robustness\")\n  |> group(columns: [\"volume\", \"state\"])\n  |> last()\n  |> filter(fn: (r) => r._value == 1.0 and r.state != \"unknown\")\n  |> map(fn: (r) => ({volume: r.volume, good: if r.state == \"healthy\" then 1 else 0}))\n  |> group()\n  |> reduce(identity: {good: 0, total: 0}, fn: (r, accumulator) => ({good: accumulator.good + r.good, total: accumulator.total + 1}))\n  |> map(fn: (r) => ({_time: now(), status: string(v: r.good) + \" of \" + string(v: r.total) + \" volumes healthy\", _value: 100.0 * float(v: r.good) / float(v: r.total)}))\n  |> group(columns: [\"status\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 40
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "light-green",
                "value": 90
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
