    {
      "type": "stat",
      "title": "ArgoCD apps not Synced+Healthy",
      "description": "Counts apps whose latest health is not Healthy or sync is not Synced. Zero rows means all fine and shows No data.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-pilab"
          },
          "query": "from(bucket: \"telegraf\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"prometheus\" and r.service == \"argocd\" and r._field == \"argocd_app_info\")\n  |> group(columns: [\"name\", \"health_status\", \"sync_status\"])\n  |> last()\n  |> filter(fn: (r) => r.health_status != \"Healthy\" or r.sync_status != \"Synced\")\n  |> group()\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
