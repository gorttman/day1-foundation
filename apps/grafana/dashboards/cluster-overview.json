    {
      "type": "table",
      "title": "Pod memory, top 15 (working set)",
      "description": "Latest sample per pod, summed over its containers. Deployment pod names are shortened (ReplicaSet hash removed).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-pilab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-pilab"
          },
          "query": "import \"regexp\"\n\nfrom(bucket: \"telegraf\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"kubernetes_pod_container\" and r._field == \"memory_working_set_bytes\")\n  |> group(columns: [\"namespace\", \"pod_name\", \"container_name\"])\n  |> last()\n  |> group(columns: [\"namespace\", \"pod_name\"])\n  |> sum()\n  |> map(fn: (r) => ({pod: r.namespace + \"/\" + regexp.replaceAllString(r: /-[a-f0-9]{16,}$/, v: regexp.replaceAllString(r: /-[a-z0-9]{8,10}-[a-z0-9]{5}$/, v: r.pod_name, t: \"\"), t: \"\"), memory: r._value}))\n  |> group()\n  |> sort(columns: [\"memory\"], desc: true)\n  |> limit(n: 15)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "custom.width",
                "value": 150
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "memory",
            "desc": true
          }
        ]
      },
      "id": 12,
      "gridPos": {
        "h": 16,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "pod": 0,
              "memory": 1
            }
          }
        }
      ]
    },
