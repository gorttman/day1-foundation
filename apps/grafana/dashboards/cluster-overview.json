    {
      "type": "stat",
      "title": "ArgoCD apps good",
      "description": "Apps that are both Healthy and Synced, out of all ArgoCD apps. Full green only when every one is good; light green at 90% or more, yellow at 70%, orange at 40%, red below that. Uses each app's latest state, so a state change never counts an app twice.",
      "id": 15,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-pilab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-pilab"
          },
          "query": "from(bucket: \"telegraf\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"prometheus\" and r.service == \"argocd\" and r._field == \"argocd_app_info\")\n  |> group(columns: [\"name\"])\n  |> top(n: 1, columns: [\"_time\"])\n  |> map(fn: (r) => ({name: r.name, good: if r.health_status == \"Healthy\" and r.sync_status == \"Synced\" then 1 else 0}))\n  |> group()\n  |> reduce(identity: {good: 0, total: 0}, fn: (r, accumulator) => ({good: accumulator.good + r.good, total: accumulator.total + 1}))\n  |> map(fn: (r) => ({_time: now(), status: string(v: r.good) + \" of \" + string(v: r.total) + \" apps good\", _value: 100.0 * float(v: r.good) / float(v: r.total)}))\n  |> group(columns: [\"status\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 40
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "light-green",
                "value": 90
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
